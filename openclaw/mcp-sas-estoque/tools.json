{
  "name": "sas-estoque-ayla",
  "version": "1.0.0",
  "description": "Ferramentas MCP da API Ayla v1 (somente leitura) — SAS-Estoque",
  "base_url": "{AYLA_API_URL}/api/ayla/v1",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "env": "AYLA_SAS_TOKEN"
  },
  "tools": [
    {
      "name": "kanban_consultar",
      "description": "Consulta tarefas do Kanban Administrativo (somente leitura). Use para perguntas sobre tarefas pendentes, atrasadas, por responsável, unidade, setor ou prioridade.",
      "method": "GET",
      "path": "/kanban",
      "parameters": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "pendente, atrasado, em_andamento, concluida, bloqueada, planejamento, a_fazer, em_execucao, aguardando, finalizado"
          },
          "prioridade": {
            "type": "string",
            "description": "baixa, media ou alta"
          },
          "responsavel": {
            "type": "string",
            "description": "Nome do responsável (busca parcial)"
          },
          "unidade": {
            "type": "string",
            "description": "Nome da unidade (ex.: Centro)"
          },
          "unidade_id": {
            "type": "integer",
            "description": "ID da unidade"
          },
          "setor": {
            "type": "string",
            "description": "RH, Financeiro, Estoque, Compras, Cozinha, etc."
          },
          "data": {
            "type": "string",
            "description": "Prazo YYYY-MM-DD"
          },
          "vencimento": {
            "type": "string",
            "description": "hoje, amanha ou atrasado"
          },
          "texto": {
            "type": "string",
            "description": "Busca em título, descrição ou observações"
          },
          "limit": {
            "type": "integer",
            "description": "Máximo de tarefas retornadas (1-50)"
          }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["tarefas", "total", "retornadas", "filtros_aplicados", "resumo"]
      }
    },
    {
      "name": "patrimonio_consultar",
      "description": "Consulta bens patrimoniais (somente leitura). Use para perguntas sobre bens, equipamentos, veículos, computadores, geladeiras, máquinas, móveis, número patrimonial ou localização.",
      "method": "GET",
      "path": "/patrimonio",
      "parameters": {
        "type": "object",
        "properties": {
          "busca": { "type": "string", "description": "Nome, código, série, marca, modelo, fornecedor" },
          "patrimonio_id": { "type": "integer", "description": "ID do bem" },
          "unidade_id": { "type": "integer", "description": "ID da unidade" },
          "unidade": { "type": "string", "description": "Nome da unidade (ex.: Doce Norte)" },
          "categoria": { "type": "string", "description": "Nome ou ID da categoria (ex.: Informática, Veículos)" },
          "status": { "type": "string", "description": "ativo, manutencao, baixado, vendido, quebrado" },
          "responsavel": { "type": "string", "description": "Nome do responsável (parcial)" },
          "setor": { "type": "string", "description": "Nome ou ID do setor" },
          "data_inicio": { "type": "string", "description": "Aquisição inicial YYYY-MM-DD" },
          "data_fim": { "type": "string", "description": "Aquisição final YYYY-MM-DD" },
          "valor_minimo": { "type": "number", "description": "Valor de compra mínimo" },
          "valor_maximo": { "type": "number", "description": "Valor de compra máximo" },
          "limite": { "type": "integer", "description": "Máximo de bens (1-50)" }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["bens", "total", "retornados", "filtros_aplicados"]
      }
    },
    {
      "name": "patrimonio_resumo",
      "description": "Resumo patrimonial: totais, valor total, por unidade, por categoria, aquisições recentes, mais antigos, maior valor e alertas. Use para 'resumo do patrimônio' ou 'valor total do patrimônio'.",
      "method": "GET",
      "path": "/patrimonio/resumo",
      "parameters": {
        "type": "object",
        "properties": {
          "unidade_id": { "type": "integer", "description": "Unidade (opcional)" },
          "categoria": { "type": "string", "description": "Categoria (opcional)" }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["total_bens", "total_ativo", "total_manutencao", "valor_total_aquisicao", "valor_total_atual", "por_unidade", "por_categoria", "alertas"]
      }
    },
    {
      "name": "patrimonio_detalhar",
      "description": "Detalha um bem patrimonial (inclui manutenções e movimentações).",
      "method": "GET",
      "path": "/patrimonio/{id}",
      "path_params": ["id"],
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "ID do bem" }
        },
        "required": ["id"]
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"]
      }
    },
    {
      "name": "patrimonio_por_unidade",
      "description": "Resumo e lista de bens de uma unidade.",
      "method": "GET",
      "path": "/patrimonio/unidade/{id}",
      "path_params": ["id"],
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "ID da unidade" }
        },
        "required": ["id"]
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["unidade", "resumo", "bens"]
      }
    },
    {
      "name": "patrimonio_alertas",
      "description": "Alertas patrimoniais: garantia próxima/vencida, manutenção próxima/atrasada, bens sem responsável, sem unidade, sem número patrimonial ou em situação irregular.",
      "method": "GET",
      "path": "/patrimonio/alertas",
      "parameters": {
        "type": "object",
        "properties": {
          "unidade_id": { "type": "integer", "description": "Unidade (opcional)" }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["garantia_proxima", "garantia_vencida", "manutencao_proxima", "manutencao_atrasada", "bens_sem_responsavel", "bens_sem_unidade", "bens_sem_codigo", "bens_situacao_irregular"]
      }
    },
    {
      "name": "reservas_consultar",
      "description": "Consulta reservas de mesa (somente leitura). Use para reservas de hoje/amanhã/semana, por status, unidade, cliente, quantidade de pessoas, horário ou histórico.",
      "method": "GET",
      "path": "/reservas",
      "parameters": {
        "type": "object",
        "properties": {
          "busca": { "type": "string", "description": "Cliente, observação, local ou ocasião" },
          "reserva_id": { "type": "integer" },
          "unidade_id": { "type": "integer" },
          "mesa_id": { "type": "integer" },
          "status": { "type": "string", "description": "pendente, confirmada, cancelada, cliente_chegou, no_show, finalizada" },
          "data": { "type": "string", "description": "YYYY-MM-DD" },
          "data_inicio": { "type": "string" },
          "data_fim": { "type": "string" },
          "cliente": { "type": "string" },
          "telefone": { "type": "string" },
          "quantidade_minima": { "type": "integer" },
          "quantidade_maxima": { "type": "integer" },
          "horario_inicio": { "type": "string" },
          "horario_fim": { "type": "string" },
          "limite": { "type": "integer", "description": "1-50" }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["reservas", "total", "retornadas", "filtros_aplicados"]
      }
    },
    {
      "name": "reservas_resumo",
      "description": "Resumo de reservas: totais, hoje, amanhã, por status, por unidade, por horário e mesas mais usadas.",
      "method": "GET",
      "path": "/reservas/resumo",
      "parameters": {
        "type": "object",
        "properties": {
          "unidade_id": { "type": "integer", "description": "Unidade (opcional)" }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"]
      }
    },
    {
      "name": "reservas_detalhar",
      "description": "Detalha uma reserva de mesa.",
      "method": "GET",
      "path": "/reservas/{id}",
      "path_params": ["id"],
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "ID da reserva" }
        },
        "required": ["id"]
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"]
      }
    },
    {
      "name": "reservas_por_unidade",
      "description": "Resumo e lista de reservas do dia de uma unidade.",
      "method": "GET",
      "path": "/reservas/unidade/{id}",
      "path_params": ["id"],
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "ID da unidade" }
        },
        "required": ["id"]
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["unidade", "resumo", "reservas"]
      }
    },
    {
      "name": "reservas_disponibilidade",
      "description": "Mesas disponíveis/ocupadas para unidade, data e horário. Conflito = mesma mesa + data + horário exato.",
      "method": "GET",
      "path": "/reservas/disponibilidade",
      "parameters": {
        "type": "object",
        "properties": {
          "unidade_id": { "type": "integer" },
          "data": { "type": "string", "description": "YYYY-MM-DD" },
          "horario": { "type": "string", "description": "HH:MM" },
          "quantidade_pessoas": { "type": "integer" },
          "duracao_minutos": { "type": "integer", "description": "Informativo; banco não grava duração" }
        },
        "required": ["unidade_id", "data", "horario"]
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"],
        "data_fields": ["mesas_disponiveis", "mesas_ocupadas", "sugestao", "observacoes"]
      }
    },
    {
      "name": "reservas_alertas",
      "description": "Alertas: próximas, sem confirmação, atrasadas, conflitos, sem mesa, acima da capacidade, canceladas recentes.",
      "method": "GET",
      "path": "/reservas/alertas",
      "parameters": {
        "type": "object",
        "properties": {
          "unidade_id": { "type": "integer", "description": "Unidade (opcional)" }
        }
      },
      "response": {
        "envelope": ["success", "message", "data", "meta"]
      }
    }
  ]
}
