# ------------------------------------------------------------------
# Ayla — Bridge de autenticação do Telegram (VPS)
# Copie para .env e preencha. Nunca versione o .env real.
# ------------------------------------------------------------------

# Token do bot do Telegram (BotFather). Usado para responder "acesso negado".
TELEGRAM_BOT_TOKEN=

# Endpoint de validação da Ayla (não altere salvo se mudar o domínio).
SAS_AYLA_URL=https://api.gruposaborparaense.com.br/api/ayla/v1/acesso/validar

# Token Bearer da Ayla (gerado em: SAS-Estoque → Ayla IA → Configurações → Token).
SAS_TOKEN=

# Token dedicado ao bridge para /telegram/vincular (deve ser igual ao AYLA_BRIDGE_TOKEN do SAS).
AYLA_BRIDGE_TOKEN=

# Opcional: URL explícita de vínculo (senão derivada de SAS_AYLA_URL).
# SAS_AYLA_VINCULAR_URL=https://api.gruposaborparaense.com.br/api/ayla/v1/telegram/vincular

# Webhook local do OpenClaw (webhook mode). Padrão do OpenClaw:
OPENCLAW_WEBHOOK_URL=http://127.0.0.1:8787/telegram-webhook

# Segredo do webhook do Telegram. Deve ser IGUAL em:
#  - setWebhook (secret_token)
#  - channels.telegram.webhookSecret do OpenClaw
TELEGRAM_WEBHOOK_SECRET=

# Porta/host/caminho públicos deste bridge (atrás de reverse proxy, ex.: nginx).
BRIDGE_PORT=8080
BRIDGE_HOST=127.0.0.1
BRIDGE_PATH=/telegram-webhook

# Cache de autorização (ms). Revogação passa a valer após este tempo. 5 min = 300000.
AUTH_CACHE_TTL_MS=300000

# Timeout de chamadas HTTP (ms).
HTTP_TIMEOUT_MS=12000

# Mensagem de acesso negado (opcional — já tem padrão em português).
# DENY_MESSAGE=
