@startuml DELIVERY_Fluxo_Prototipo
title Delivery — Fluxo vitrine (ref. VendaFácil, adaptado GSP)
skinparam backgroundColor #FAFAF8

start
:Vitrine (deliveryVitrine);
:Banner + categorias + busca;
:Card produto → Modal;
note right: adicionais, variações,\nretiradas, observação
:Adicionar ao carrinho;
:Carrinho flutuante;
if (Finalizar?) then (sim)
  :Cliente (nome, tel, WhatsApp);
  if (Entrega?) then (sim)
    :Endereço + taxa demo;
  else (retirada)
    :Unidade + horário;
  endif
  :Pagamento (PIX QR demo / troco);
  :Pedido fictício + timeline;
  :Link wa.me demonstrativo;
endif
stop

@enduml
